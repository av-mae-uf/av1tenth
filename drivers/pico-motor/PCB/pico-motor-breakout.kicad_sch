	(text "Motor Header"
		(exclude_from_sim no)
		(at 49.276 90.932 0)
		(effects
			(font
				(size 1.905 1.905)
				(thickness 0.381)
				(bold yes)
			)
		)
		(uuid "8141aad0-2ab6-4303-bcfc-45b1853dcfc3")
	)
	(text_box "Motor Pin Selection (JP1 / JP2)\nIn case something goes wrong, I added a jumper to choose which GPIO pin to use:\n- JP1 connects Pin 1 to the header\n- JP2 connects Pin 2 to the header\n\nDONT SOLDER BOTH - PICK ONE!"
		(exclude_from_sim no)
		(at 20.32 113.03 0)
		(size 60.96 17.78)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 255 150 1)
		)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "92946c12-722a-4925-a9c2-0b4bc74aceee")
	)
	(text_box "Servo Header Selection (JP3-JP6)\nSame idea as the Motor Header - jumpers select which GPIO pin and power source to use:\n- JP3 connects Pin 2 to the header's signal pin\n- JP4 connects Pin 3 to the header's signal pin\n- JP5 connects Pico 5V to the header's power pin\n- JP6 connects screw terminal power to the header's power pin\nONLY SOLDER ONE from JP3/JP4, and ONE from JP5/JP6."
		(exclude_from_sim no)
		(at 116.84 49.53 0)
		(size 78.74 17.78)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 255 150 1)
		)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "c5bc6919-bcf6-4fc9-805b-608903b9aefd")
	)
	(text_box "Expandable GPIO pins\n\nPin 8  → I2C0 SDA, SPI1 RX, UART1 TX  \nPin 9  → I2C0 SCL, SPI1 CSn, UART1 RX  \n\nPin 14 → I2C1 SDA, SPI1 SCK  \nPin 15 → I2C1 SCL, SPI1 TX  \n\nPin 26 → I2C1 SDA, ADC0  \nPin 27 → I2C1 SCL, ADC1"
		(exclude_from_sim no)
		(at 154.94 78.74 0)
		(size 41.91 22.86)
		(margins 0.9525 0.9525 0.9525 0.9525)
